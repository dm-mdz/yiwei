1 ICON "yiwei.ico"
1 24 "yiwei.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "FileDescription", "Yiwei key and mouse sharing"
      VALUE "ProductName", "Yiwei"
      VALUE "ProductVersion", "0.1.0"
      VALUE "LegalCopyright", "MIT License, Yiwei contributors"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
